# API base URL
VITE_API_BASE_URL=https://api.yourchatapp.com

# WebSocket server URL
VITE_WS_URL=wss://ws.yourchatapp.com

# Firebase config
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# AWS S3
VITE_AWS_BUCKET_URL=https://your-bucket.s3.amazonaws.com

# Auth
VITE_JWT_SECRET=your_jwt_secret
VITE_SOCIAL_LOGIN_GOOGLE_CLIENT_ID=your_google_client_id
VITE_SOCIAL_LOGIN_FACEBOOK_APP_ID=your_facebook_app_id

# Logging & Monitoring
VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# App Info
VITE_APP_NAME=Chatly
VITE_APP_ENV=development
VITE_APP_VERSION=1.0.0
